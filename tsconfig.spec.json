{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/testing/**/*.ts",
    "src/testing/**/*.tsx",
    "vitest.setup.ts"
  ],
  "exclude": ["dist", "node_modules", "sample-app-old/", "sample-app/"]
}
