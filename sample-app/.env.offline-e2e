# Loaded only by `vite --mode offline-e2e` (npm run dev:offline-e2e), which the
# offline Playwright suite (playwright.offline.config.ts) starts. It points the
# app at the offline conformance harness's local fake CometChat server: no real
# App ID, keys or network. The kit is built from ../src in this mode (vite.config.ts).
VITE_COMETCHAT_APP_ID=app1
VITE_COMETCHAT_REGION=us
VITE_COMETCHAT_AUTH_KEY=fake-server-auth-key
VITE_COMETCHAT_CLIENT_HOST=127.0.0.1:51787/v3.0
VITE_COMETCHAT_ADMIN_HOST=127.0.0.1:51787/v3.0
VITE_COMETCHAT_OFFLINE=1
VITE_COMETCHAT_CALLING=0
