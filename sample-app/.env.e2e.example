# CometChat E2E Testing Credentials
# Copy this file to .env.e2e and fill in your values.
# DO NOT commit .env.e2e to source control.
#
# Use a CometChat app dedicated to E2E testing: the suite creates and deletes
# e2e-* users and groups. Every variable the suite reads is listed in this file;
# values that are the same for everyone live in sample-app/e2e/ instead.

COMETCHAT_APP_ID=
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=
COMETCHAT_API_KEY=

# Optional: UID of the AI Agent user (defaults to 'ai-agent-e2e' if not set)
# Must be created manually in dashboard with @agentic role, named "AI Agent E2E"
AI_AGENT_UID=ai-agent-e2e

# Optional: MIME type denied in the dashboard, used by the multi-attachment
# "file type not supported" test. Must match the type you blocked (see the
# "Optional fixtures — multi-attachment error states" section of the UIKit README).
# Example: E2E_BLOCKED_MIME_TYPE=image/svg+xml
E2E_BLOCKED_MIME_TYPE=

# ─── Pin & Save ───────────────────────────────────────────────────────────────
# The pin-message limit test is only meaningful (and fast) at a cap of 5. It runs
# ONLY when this equals 5 — otherwise it self-skips. Set it to your app's
# "features.ux.messages.pinned.limit" value.
E2E_PIN_MESSAGES_LIMIT=
#
# Pin-permission tests need no flags: keep the DEFAULT participant permissions in
# the app (pin denied, unpin denied, pinned listing allowed) — see README → Pin &
# Save prerequisites. A denied listing is simulated by the tests themselves.

# ─── Agentic Group Chat ──────────────────────────────────────────
# Two @agentic users used as members of the agentic test groups.
# Create them manually in the dashboard (BYO Agents → @agentic role), then paste
# their UIDs here. Leave blank to SKIP all agentic-group e2e tests.
GROUP_AGENT_1_UID=
GROUP_AGENT_2_UID=

# Group used to test 1 user + 1 agent: the agent replies to a plain message
# WITHOUT needing an @mention.
# Leave blank on the FIRST run — the suite creates the group automatically (gid
# "e2e-agentic-group-1") and prints the id in the console. Paste it back here so
# later runs reuse the same group instead of relying on the fallback.
AGENTIC_GROUP_1_ID=

# Group used to test multiple users + 2 agents: an agent replies ONLY when it is
# @mentioned. Same first-run behaviour as above (fallback gid "e2e-agentic-group-2").
AGENTIC_GROUP_2_ID=

# ─── Run options (optional) ──────────────────────────────────────
# Tests reuse each user's signed-in session instead of signing in through the UI
# every time. Set to 1 to always sign in through the UI.
E2E_FRESH_LOGIN=
# Set to 1 to record which UI Kit source lines the run executes. Build the sample
# app from the local kit with source maps first:
#   UIKIT_LOCAL=1 npm run build -- --sourcemap
# The report is written to coverage/e2e/ (open coverage/e2e/index.html).
E2E_COVERAGE=
